# DeepSeek API Key
# 获取地址：https://platform.deepseek.com/ -> API Keys
# 复制本文件为 .env.local 并填入真实 key
DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# 限流身份：设为 1 时信任反代的 X-Real-IP / XFF 最右 hop
# 裸暴露 next start（当前腾讯云）请保持不设或 0，忽略客户端伪造的 XFF
# TRUST_PROXY=1

# 可选：允许 POST /api/dish mode=ai 的运维令牌（请求头 x-wha2eat-ai-token 或 Authorization: Bearer）
# 未配置时拒绝所有 mode=ai；前端默认 quick，不受影响
# WHA2EAT_AI_TOKEN=
